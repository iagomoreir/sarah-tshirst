# Arquivos com hash no nome: cache longo. index.html segue a revalidação padrão.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Chave pública do cachet dos contratos: texto legível no navegador
/.well-known/*
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
